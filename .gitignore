# Root level gitignore for InventPro
# Only push: frontend/, backend/, and documentation files

# Keep these folders
!frontend/
!backend/

# Keep these documentation files
!README.md
!WORKFLOW.md
!IMPLEMENTATION_REPORT.md
!inventory-system-specification.md
!ROADMAP.md
!.gitignore

# Ignore everything else at root level
*
!.gitignore