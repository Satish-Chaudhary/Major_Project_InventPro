# Ignore all markdown files at root except the ones we want to push
*.md

# Ignore other root level files
*.txt
*.json
*.js
*.ts
*.py
*.log
*.tmp
*.env
*.env.production
*.yaml
*.yml

# Ignore common directories
node_modules/
dist/
build/
logs/

# Ignore IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ignore AI/Agent tool folders
.kilo/
.agent/
.gemini/
.gsd/

# Allow only specific files and folders to push
!README.md
!WORKFLOW.md
!IMPLEMENTATION_REPORT.md
!inventory-system-specification.md
!.gitignore
!frontend/
!backend/