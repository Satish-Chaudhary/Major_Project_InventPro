# Root level gitignore for InventPro
# Only push these folders and files:
# - frontend/
# - backend/
# - README.md
# - WORKFLOW.md
# - IMPLEMENTATION_REPORT.md
# - inventory-system-specification.md

# Keep core folders
!frontend/
!backend/

# Keep documentation
!README.md
!WORKFLOW.md
!IMPLEMENTATION_REPORT.md
!inventory-system-specification.md
!ROADMAP.md

# Ignore everything else at root
*
!.gitignore